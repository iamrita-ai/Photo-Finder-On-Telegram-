# ---- Required ----
BOT_TOKEN=123456789:AAExample-your-bot-token-here
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGO_DB_NAME=pinterest_bot

# WEBHOOK_URL: on Render this is auto-detected from RENDER_EXTERNAL_HOSTNAME,
# so you usually don't need to set it there. Set it manually only for local
# testing with a tunnel (ngrok etc.) or non-Render hosts.
WEBHOOK_URL=https://your-app.onrender.com
WEBHOOK_SECRET=

# ---- Optional ----
PORT=8000
DEFAULT_RESULT_LIMIT=10
INLINE_RESULT_LIMIT=20
EXTRA_OWNER_IDS=

# Optional best-effort Pinterest login (see login_service.py) — only needed
# if you want to try the owner-only /login command. Search works without it.
PINTEREST_EMAIL=
PINTEREST_PASSWORD=
